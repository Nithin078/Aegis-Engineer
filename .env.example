# Aegis Engineer — copy to `.env` and fill in values.
#   copy .env.example .env
#
# Shell environment variables always win over this file.
# This file is gitignored when named `.env` — never commit secrets.

# ── Provider (used by aegis config / factory) ──────────────────────────────
AEGIS_PROVIDER=openai
AEGIS_MODEL=llama-3.3-70b-versatile

# ── Groq (OpenAI-compatible) ───────────────────────────────────────────────
# Get a key: https://console.groq.com
OPENAI_API_KEY=gsk_your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ── Optional alternatives ──────────────────────────────────────────────────
# Local Ollama:
# AEGIS_PROVIDER=ollama
# AEGIS_MODEL=qwen2.5-coder:7b
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Anthropic (paid):
# AEGIS_PROVIDER=anthropic
# AEGIS_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub (Phase 9 — optional; private issues + PR create) ────────────────
# GITHUB_TOKEN=ghp_...
# GH_TOKEN=ghp_...

# ── Other Aegis settings ───────────────────────────────────────────────────
# AEGIS_PERMISSION_MODE=yolo
# AEGIS_LOG_LEVEL=info
# AEGIS_SERVER_PORT=4096
# AEGIS_DB_PATH=
# AEGIS_CONFIG_DIR=
